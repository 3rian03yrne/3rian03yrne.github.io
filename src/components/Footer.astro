---
import { SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer
	class="bg-[linear-gradient(rgb(229_233_240/50%),#fff)] bg-no-repeat px-4 pt-8 pb-24 text-center text-gray"
>
	&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
	<SocialLinks class="mt-4 justify-center text-gray" />
</footer>
