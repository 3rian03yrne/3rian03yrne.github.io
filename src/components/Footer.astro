---
import { GITHUB_USERNAME, LINKEDIN_URL, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="bg-bg">
	<div
		class="flex items-center justify-between border-t border-border px-8 py-4 max-hero:flex-col max-hero:items-start max-hero:gap-3 max-hero:px-6"
	>
		<p class="m-0 text-[10px] tracking-label-md text-muted-dark">&copy; {today.getFullYear()} {SITE_TITLE}</p>
		<div class="flex gap-5">
			<a
				href={`https://github.com/${GITHUB_USERNAME}`}
				target="_blank"
				rel="noopener"
				class="text-[10px] uppercase tracking-label-lg text-muted-dark transition-colors duration-150 hover:text-muted"
			>
				GitHub
			</a>
			<a
				href={LINKEDIN_URL}
				target="_blank"
				rel="noopener"
				class="text-[10px] uppercase tracking-label-lg text-muted-dark transition-colors duration-150 hover:text-muted"
			>
				LinkedIn
			</a>
		</div>
	</div>
</footer>
