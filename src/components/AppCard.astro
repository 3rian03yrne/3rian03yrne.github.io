---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	icon: ImageMetadata;
	badgeLabel: string;
	href: string;
	externalUrl?: string;
}

const { title, description, icon, badgeLabel, href, externalUrl } = Astro.props;

const cardClasses =
	'flex items-center gap-4 rounded-xl bg-white p-4 transition-shadow duration-200 hover:shadow-card';
const iconClasses = 'h-12 w-12 shrink-0 overflow-hidden rounded-lg';
const badgeClasses = 'shrink-0 whitespace-nowrap text-base text-accent';
---

{
	externalUrl ? (
		<div class={`relative ${cardClasses}`}>
			{/* Full-card overlay link to the internal project page. Sits below the
			    badge link (which is `relative z-10`) so the badge stays independently
			    clickable — avoids nesting an <a> inside an <a>. */}
			<a href={href} aria-label={title} class="absolute inset-0 z-0" />
			<div class={iconClasses}>
				<Image src={icon} width={48} height={48} alt="" class="block h-full w-full object-cover" />
			</div>
			<div class="flex-1">
				<p class="m-0 text-black">{title}</p>
				<p class="m-0 text-base text-gray">{description}</p>
			</div>
			<a href={externalUrl} target="_blank" rel="noopener" class={`relative z-10 ${badgeClasses}`}>
				{badgeLabel}
			</a>
		</div>
	) : (
		<a href={href} class={`${cardClasses} no-underline`}>
			<div class={iconClasses}>
				<Image src={icon} width={48} height={48} alt="" class="block h-full w-full object-cover" />
			</div>
			<div class="flex-1">
				<p class="m-0 text-black">{title}</p>
				<p class="m-0 text-base text-gray">{description}</p>
			</div>
			<span class={badgeClasses}>{badgeLabel}</span>
		</a>
	)
}
