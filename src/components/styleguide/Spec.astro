---
/**
 * One component's entry on /styleguide: name, source path, prop table, then the
 * specimen panes in the default slot.
 */
interface PropRow {
  name: string;
  type: string;
  default?: string;
  note?: string;
}

interface Props {
  name: string;
  /** Source path, shown so the page doubles as an index of the directory. */
  file: string;
  summary: string;
  rows?: PropRow[];
  /** What the component's default <slot> takes, if it has one. */
  slotNote?: string;
  /** Anything the static page can't show — hover states, root-scoped CSS. */
  caveat?: string;
}

const { name, file, summary, rows = [], slotNote, caveat } = Astro.props;
---

<section class="spec">
  <header class="spec-head">
    <h2 class="spec-name">{name}</h2>
    <code class="spec-file">{file}</code>
  </header>

  <p class="summary">{summary}</p>

  {
    rows.length > 0 && (
      <div class="table-wrap">
        <table class="props">
          <thead>
            <tr>
              <th>Prop</th>
              <th>Type</th>
              <th>Default</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td>
                  <code>{row.name}</code>
                </td>
                <td>
                  <code>{row.type}</code>
                </td>
                <td>
                  {row.default ? (
                    <code>{row.default}</code>
                  ) : (
                    <span class="none">—</span>
                  )}
                </td>
                <td>{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    slotNote && (
      <p class="summary">
        <code>&lt;slot /&gt;</code> — {slotNote}
      </p>
    )
  }

  {caveat && <p class="caveat">{caveat}</p>}

  <slot />
</section>

<style>
  .spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-7);
    border-top: 1px solid var(--border-1);
  }

  .spec-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .spec-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-panel-title);
    letter-spacing: var(--track-panel);
    color: var(--text-1);
  }

  .spec-file {
    font-size: var(--text-code);
    color: var(--text-dim);
  }

  .summary {
    margin: 0;
    max-width: 84ch;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .caveat {
    margin: 0;
    max-width: 84ch;
    padding-left: var(--space-4);
    border-left: 2px solid var(--warn);
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .props {
    border-collapse: collapse;
    font-size: var(--text-term);
  }

  .props th,
  .props td {
    padding: 6px 18px 6px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border-1);
  }

  .props th {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-kicker-xs);
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .props td {
    color: var(--text-dim);
  }

  .none {
    color: var(--text-dim);
  }
</style>
