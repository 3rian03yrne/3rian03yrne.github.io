---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL;
// Compare the first path segment so nested pages (e.g. /blog/a-post/) keep
// their section highlighted, regardless of leading/trailing slashes.
const firstSegment = (path: string) =>
  path.slice(path.startsWith(base) ? base.length : 0).match(/[^\/]+/g)?.[0] ??
  "";
const isActive =
  firstSegment(Astro.url.pathname) === firstSegment(String(href ?? ""));
---

<a
  href={href}
  class:list={["nav-link", className, { active: isActive }]}
  {...props}
>
  <slot />
</a>

<style>
  .nav-link {
    display: inline-block;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    font-size: var(--text-kicker-sm);
    font-weight: 700;
    letter-spacing: var(--track-kicker-xs);
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text-1);
  }

  .nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
