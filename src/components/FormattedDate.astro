---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Date-only frontmatter parses as UTC midnight; format in UTC so the
			// build machine's timezone can't shift it back a day.
			timeZone: 'UTC',
		})
	}
</time>
