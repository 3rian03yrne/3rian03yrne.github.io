---
import { SegmentBar, type Segment } from "./SegmentBar";
import type { PromptKind, PromptSegment } from "./types";

interface Props {
  segments?: PromptSegment[];
}

const KIND_STYLES: Record<PromptKind, Omit<Segment, "label">> = {
  path: {
    bg: "var(--prompt-path-bg)",
    fg: "var(--prompt-path-fg)",
    weight: 700,
    padding: "5px 16px",
    radius: "var(--radius-pill)",
  },
  git: {
    bg: "var(--prompt-git-bg)",
    fg: "var(--prompt-git-fg)",
    weight: 500,
    padding: "5px 16px",
    radius: "var(--radius-pill)",
  },
  ok: {
    bg: "var(--prompt-ok-bg)",
    fg: "var(--prompt-ok-fg)",
    weight: 700,
    padding: "5px 14px",
    radius: "var(--radius-pill)",
  },
  time: {
    fg: "var(--text-dim)",
    weight: 400,
    padding: "5px 8px",
  },
};

const DEFAULT_SEGMENTS: PromptSegment[] = [
  { label: "~/site", kind: "path" },
  { label: "⎇ main", kind: "git" },
  { label: "✓", kind: "ok" },
  { label: "184ms", kind: "time" },
];

const { segments = DEFAULT_SEGMENTS } = Astro.props;

const resolved: Segment[] = segments.map((s) => ({
  label: s.label,
  ...KIND_STYLES[s.kind ?? "time"],
}));
---

<SegmentBar segments={resolved} shape="pill" />
