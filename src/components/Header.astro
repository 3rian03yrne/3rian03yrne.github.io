---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header class="m-0 bg-white px-4 shadow-[0_2px_8px_rgb(15_18_25/5%)]">
	<nav class="flex items-center justify-between">
		<h2 class="m-0 text-base">
			<a href="/" class="text-black no-underline">{SITE_TITLE}</a>
		</h2>
		<ul class="m-0 flex list-none gap-0 p-0">
			{
				NAV_LINKS.map((link) => (
					<li>
						<HeaderLink href={link.href}>{link.label}</HeaderLink>
					</li>
				))
			}
		</ul>
		<SocialLinks class="text-black max-mobile:hidden" />
	</nav>
</header>
