---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SegmentRule from './padd/SegmentRule.astro';
import ThemeToggle from './padd/ThemeToggle.astro';
---

<header class="border-b border-line">
	<div
		class="mx-auto flex max-w-[1180px] items-center justify-between gap-8 px-11 py-5 max-mobile:flex-col max-mobile:items-start max-mobile:gap-4 max-mobile:px-5"
	>
		<a href="/" class="wordmark">{SITE_TITLE}</a>
		<div class="flex items-center gap-8 max-mobile:w-full max-mobile:justify-between max-mobile:gap-4">
			<nav>
				<ul class="m-0 flex list-none flex-wrap items-center gap-8 p-0 max-mobile:gap-4">
					{
						NAV_LINKS.map((link) => (
							<li>
								<HeaderLink href={link.href}>{link.label}</HeaderLink>
							</li>
						))
					}
				</ul>
			</nav>
			<ThemeToggle />
		</div>
	</div>
</header>
<SegmentRule />

<style>
	.wordmark {
		font-family: var(--font-display);
		font-size: var(--text-heading);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-1);
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark:hover {
		color: var(--accent);
	}
</style>
