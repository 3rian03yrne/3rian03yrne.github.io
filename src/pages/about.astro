---
import Page from "../layouts/Page.astro";
import { SITE_TITLE } from "../consts";
---

<Page
  title={`About | ${SITE_TITLE}`}
  description="About Brian O'Byrne."
  heading="About"
>
  <p>
    This is the personal website of Brian O'Byrne built with <a
      href="https://astro.build/"
      target="_blank"
      rel="noopener">Astro</a
    > and hosted using <a
      href="https://pages.github.com/"
      target="_blank"
      rel="noopener">GitHub Pages</a
    >.
  </p>

  <p>Brian O'Byrne lives in Portland, Oregon with his family.</p>

  <p>
    A Software Engineer by trade, his interests are many and varied and include
    coffee, art, music, the outdoors, off-roading, working on his truck, Star
    Trek, cooking, eating, hiking, camping, reading, deep thinking, light
    thinking, and optimism.
  </p>

  <div
    data-iframe-width="150"
    data-iframe-height="270"
    data-share-badge-id="56613a29-7c0c-43bf-998d-416fef688637"
    data-share-badge-host="https://www.credly.com"
  >
  </div><script
    type="text/javascript"
    async
    src="//cdn.credly.com/assets/utilities/embed.js"></script>
</Page>
