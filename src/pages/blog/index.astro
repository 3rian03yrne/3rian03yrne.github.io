---
import FeaturedEntry from "../../components/terminal/FeaturedEntry.astro";
import PageBanner from "../../components/terminal/PageBanner.astro";
import Pill from "../../components/terminal/Pill.astro";
import SectionDivider from "../../components/terminal/SectionDivider.astro";
import StreamItem from "../../components/terminal/StreamItem.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLogs } from "../../lib/stream";

const logs = await getLogs();
const [latest, ...rest] = logs;
---

<BaseLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="flex flex-col gap-10">
    <PageBanner title="Blog" intro={SITE_DESCRIPTION} />

    <section>
      <SectionDivider label={`All entries · ${logs.length}`}>
        <a href="/rss.xml"><Pill tone="dim">RSS</Pill></a>
      </SectionDivider>

      {latest && <FeaturedEntry entry={latest} />}

      {rest.map((entry) => <StreamItem entry={entry} />)}

      <div class="border-line border-t"></div>
    </section>
  </div>
</BaseLayout>
