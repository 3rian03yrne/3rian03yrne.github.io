---
import { getCollection } from 'astro:content';
import AppCard from '../components/AppCard.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const featuredApps = (await getCollection('projects', ({ data }) => data.featured)).sort(
	(a, b) => a.data.title.localeCompare(b.data.title),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Brian 👋</h1>
			<p>
				Welcome to my website. I'm a software engineer based in Portland, Oregon — I build apps for iOS
				and write about what I learn along the way.
			</p>
			<p>Here's what you'll find here:</p>
			<ul>
				<li><a href="/projects/">Apps</a> — the things I've shipped.</li>
				<li><a href="/blog/">Blog</a> — notes, write-ups, and the occasional starship log.</li>
				<li><a href="/about/">About</a> — a bit more on who I am and what I'm after.</li>
			</ul>

			<h2>Featured apps</h2>
			<div class="flex flex-col gap-4">
				{
					featuredApps.map((project) => (
						<AppCard
							title={project.data.title}
							description={project.data.tagline ?? project.data.description}
							icon={project.data.appIcon}
							badgeLabel={project.data.status === 'coming_soon' ? 'Coming Soon' : 'App Store'}
							href={`/projects/${project.id}/`}
							externalUrl={project.data.appStoreUrl}
						/>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
