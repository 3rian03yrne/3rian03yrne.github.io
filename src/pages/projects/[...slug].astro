---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import AppStoreBadge from '../../assets/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const {
	title,
	description,
	appIcon,
	screenshot,
	screenshotAlt,
	status,
	appStoreUrl,
	contactEmail,
	privacyPolicy,
} = project.data;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="mb-8 flex items-center gap-5">
					<Image
						width={96}
						height={96}
						src={appIcon}
						alt=""
						class="h-24 w-24 shrink-0 rounded-xl object-cover"
					/>
					<h1 class="m-0">{title}</h1>
				</header>

				{
					appStoreUrl ? (
						<a href={appStoreUrl} target="_blank" rel="noopener">
							<Image
								src={AppStoreBadge}
								alt={`Download ${title} on the App Store`}
								height={40}
								class="my-6 block w-[156px] rounded-none"
							/>
						</a>
					) : (
						status === 'coming_soon' && (
							<p class="my-6 text-gray">Coming Soon — will be available on the App Store.</p>
						)
					)
				}

				<!-- Content wrapper. Gains `prose` when the typography plugin is switched on. -->
				<div>
					<Content />
				</div>

				{
					screenshot && (
						<Image
							width={720}
							height={720}
							src={screenshot}
							alt={screenshotAlt ?? ''}
							class="my-8 block max-w-[320px] rounded-xl shadow-card"
						/>
					)
				}

				{
					privacyPolicy && (
						<div class="mt-10">
							<object
								data={privacyPolicy}
								type="application/pdf"
								aria-label={`${title} Privacy Policy`}
								class="block h-[600px] w-full rounded-lg border border-gray-light"
							>
								<a href={privacyPolicy}>Download the privacy policy</a>
							</object>
						</div>
					)
				}

				{
					(contactEmail || privacyPolicy) && (
						<footer class="mt-12 flex flex-wrap gap-5 border-t border-gray-light pt-5">
							{contactEmail && <a href={`mailto:${contactEmail}`}>{contactEmail}</a>}
							{privacyPolicy && <a href={privacyPolicy}>Privacy Policy</a>}
						</footer>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>
